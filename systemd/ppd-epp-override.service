[Unit]
Description=Apply CPU EPP and platform_profile override for power-profiles-daemon
Documentation=man:powerprofilesctl(1)
Wants=power-profiles-daemon.service
After=power-profiles-daemon.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ppd-epp-override

[Install]
WantedBy=multi-user.target
