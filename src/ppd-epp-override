#!/bin/sh
set -eu

state_file=/var/lib/power-profiles-daemon/state.ini

detect_power_source() {
	has_battery=0
	battery_discharging=0

	for supply in /sys/class/power_supply/*; do
		[ -d "$supply" ] || continue
		type="$(cat "$supply/type" 2>/dev/null || true)"
		online="$(cat "$supply/online" 2>/dev/null || true)"
		status="$(cat "$supply/status" 2>/dev/null || true)"

		if [ "$type" = "Battery" ]; then
			has_battery=1
			[ "$status" = "Discharging" ] && battery_discharging=1
			continue
		fi

		if [ "$online" = "1" ]; then
			printf '%s\n' ac
			return 0
		fi
	done

	if [ "$has_battery" -eq 1 ] && [ "$battery_discharging" -eq 1 ]; then
		printf '%s\n' battery
	else
		printf '%s\n' ac
	fi
}

# Give power-profiles-daemon a moment to finish applying its own sysfs writes
# when this is triggered by a profile change.
sleep "${PPD_EPP_OVERRIDE_DELAY:-0.2}"

profile="$(powerprofilesctl get 2>/dev/null || true)"

if [ -z "$profile" ] && [ -r "$state_file" ]; then
	while IFS='=' read -r key value; do
		if [ "$key" = "Profile" ]; then
			profile="$value"
			break
		fi
	done < "$state_file"
fi

[ "$profile" = "power-saver" ] || exit 0

power_source="$(detect_power_source)"
case "$power_source" in
	battery)
		target_epp=power
		;;
	*)
		target_epp=balance_power
		power_source=ac
		;;
esac

available_file=
for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/energy_performance_available_preferences \
	/sys/devices/system/cpu/cpu[0-9]*/cpufreq/available_energy_performance_preferences; do
	if [ -r "$f" ]; then
		available_file="$f"
		break
	fi
done

if [ -n "$available_file" ]; then
	available="$(cat "$available_file")"
	case " $available " in
		*" $target_epp "*) ;;
		*)
			logger -t ppd-epp-override "EPP preference '$target_epp' is not available: $available"
			exit 0
			;;
	esac
fi

changed=0
for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/energy_performance_preference; do
	[ -e "$f" ] || continue
	current="$(cat "$f" 2>/dev/null || true)"
	if [ "$current" != "$target_epp" ]; then
		printf '%s\n' "$target_epp" > "$f"
		changed=1
	fi
done

if [ "$changed" -eq 1 ]; then
	logger -t ppd-epp-override "Set CPU energy_performance_preference to $target_epp for power-saver on $power_source"
fi
